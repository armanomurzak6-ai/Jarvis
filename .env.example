# Скопируйте в .env и заполните. Файл .env не коммитится.

# Claude API — мозг Jarvis (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Модель Claude и глубина размышлений (low / medium / high).
# low — быстрее и дешевле, high — умнее, но дольше думает.
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium

# Picovoice (wake word «Джарвис») — нужен с шага 5 (голос)
PICOVOICE_ACCESS_KEY=

# Голос и распознавание (шаг 5)
JARVIS_TTS_VOICE=ru-RU-DmitryNeural
JARVIS_WHISPER_MODEL=small

# Уровень логирования: DEBUG, INFO, WARNING
JARVIS_LOG_LEVEL=INFO
