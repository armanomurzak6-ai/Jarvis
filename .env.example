# Скопируйте в .env и заполните. Файл .env не коммитится.

# Claude API — нужен с шага 2 (мозг)
ANTHROPIC_API_KEY=
# Модель Claude
JARVIS_MODEL=claude-sonnet-5

# Picovoice (wake word «Джарвис») — нужен с шага 5 (голос)
PICOVOICE_ACCESS_KEY=

# Голос и распознавание (шаг 5)
JARVIS_TTS_VOICE=ru-RU-DmitryNeural
JARVIS_WHISPER_MODEL=small

# Уровень логирования: DEBUG, INFO, WARNING
JARVIS_LOG_LEVEL=INFO
